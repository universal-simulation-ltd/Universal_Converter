<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Universal Converter</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The app's name wherever iOS names it in a system prompt — "“Universal Converter”
	     Wants to Use … to Sign In" among them. Left as $(PRODUCT_NAME) it read
	     "App", the Xcode target's name. Kept equal to CFBundleDisplayName (the
	     home-screen name). -->
	<key>CFBundleName</key>
	<string>Universal Converter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Universal Converter uses the camera only if you choose to take a photo to convert. Conversion happens on your device and nothing is uploaded.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Universal Converter saves converted files to your photo library when you choose to.</string>
	<!-- ⚠️ THE APP DOES NOT LAUNCH WITHOUT THIS once it is built against the
	     iOS 27 SDK. iOS terminates an app built against that SDK that still
	     uses the old app-delegate window life cycle, before any of our code
	     runs — "UIScene life cycle is required for apps built with this SDK" in
	     the device log and nothing on screen.

	     The manifest is only half of it: the runtime also checks that the app
	     delegate answers application(_:configurationForConnecting:options:).
	     Both halves, plus SceneDelegate.swift itself, are checked by
	     `npm run check:ios-launch`.

	     Capacitor adopted scenes in 8.5 and this app is on an earlier version,
	     so the three pieces are written out by hand (ported from Universal PDF).
	     There is deliberately NO UISceneStoryboardFile: SceneDelegate builds the
	     window and its bridge view controller itself (it has to, to load the
	     bridge before forwarding a launch link). Naming Main here as well would
	     have UIKit build a second window and bridge from the storyboard. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- BEGIN unisim suite app links — generated by scripts/add-suite-app-links.mjs, do not hand-edit -->
	<!-- This app's own scheme. Another suite app opens it with
	     unisim-converter:// — see UnisimSuiteAuthPlugin.openApp. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uk.co.unisim.converter</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unisim-converter</string>
			</array>
		</dict>
	</array>
	<!-- Every suite scheme this app may ask about. ⚠️ canOpenURL answers FALSE
	     for anything not listed here and says so only in the device console —
	     which the switcher cannot tell apart from "not installed". The full
	     list is written into every app deliberately: identical blocks make a
	     stale one visible. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>unisim-ergo-assess</string>
		<string>unisim-cyber-assess</string>
		<string>unisim-workplace-assess</string>
		<string>unisim-fire-assess</string>
		<string>unisim-coshh-assess</string>
		<string>unisim-risk-assess</string>
		<string>unisim-pdf</string>
		<string>unisim-images</string>
		<string>unisim-qr</string>
		<string>unisim-compress</string>
		<string>unisim-converter</string>
		<string>unisim-polling</string>
		<string>unisim-blackbook</string>
		<string>unisim-ai</string>
		<string>unisim-jukebox</string>
	</array>
	<!-- END unisim suite app links -->
</dict>
</plist>
