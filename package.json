{
  "name": "universal-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Universal Converter — convert audio and video entirely in your browser. Nothing is uploaded.",
  "scripts": {
    "predev": "node scripts/sync-flac.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-flac.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/selftest.mjs",
    "test:files": "node e2e/files.e2e.mjs",
    "test:images": "node e2e/images.e2e.mjs",
    "fixtures": "node e2e/fixtures/make-fixtures.mjs",
    "test:video": "node e2e/video.e2e.mjs",
    "test:routing": "node e2e/routing.e2e.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "cap:sync": "npm run build:desktop && npx cap sync && npm run check:mobile-bundle",
    "check:mobile-bundle": "node scripts/verify-mobile-bundle.mjs",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/share": "^7.0.4",
    "@unisim/doc": "^0.5.0",
    "@unisim/media": "^0.5.0",
    "@unisim/sdk": "^0.123.4",
    "heic-to": "^1.5.2",
    "libflacjs": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
