.DS_Store
*.log

# NOTE: `ios/` is COMMITTED, not ignored. This block ignored it from when
# capacitor.config.ts was added and no platform existed yet — but a native
# project is not a build artifact: it carries the app icons, the bundle id, the
# version wiring and the signing config, and CI cannot build a release without
# it. Universal_PDF, _AI, _QR and _Images all track theirs for the same reason.
# Capacitor's own ios/.gitignore already excludes the generated parts
# (App/build, App/Pods, the copied web assets, App/App/capacitor.config.json).
#
# `android/` stays ignored only because no Android project has been added yet.
/android

# TypeScript incremental build artifacts
*.tsbuildinfo

# Per-user Claude Code settings. `launch.json` holds this machine's preview
# port, which differs between the Mac and the Windows box — the committed
# record of who gets which port is the table in Docs_UNI_SIM/dev-preview.md.
.claude/settings.local.json
.claude/launch.json

# Internal project notes — not published (matches the other Universal Apps repos)
CLAUDE.md

# Synced from node_modules by scripts/sync-flac.mjs — never edit or commit
/public/flac/
