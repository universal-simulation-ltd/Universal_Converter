# Cloudflare Pages rewrites — Universal Converter is served under /converter/ but
# the built files in dist/ are flat (Vite's `base` only rewrites URLs INSIDE the
# HTML; it does not place files in dist/converter/).
#
# 200 status = transparent rewrite (URL bar unchanged). Specific rules first,
# broad SPA fallback last.

# Service-worker + PWA artefacts.
/converter/sw.js                /sw.js                200
/converter/registerSW.js        /registerSW.js        200
/converter/manifest.webmanifest /manifest.webmanifest 200
/converter/workbox-*            /workbox-:splat       200

# Hashed asset bundles — includes the lazily-fetched ffmpeg core.
/converter/assets/*             /assets/:splat        200

# Static files referenced from index.html / app code (BASE_URL-prefixed).
/converter/favicon.svg          /favicon.svg          200
/converter/unisim-icon.png      /unisim-icon.png      200
/converter/icon-180.png         /icon-180.png         200
/converter/icon-192.png         /icon-192.png         200
/converter/icon-512.png         /icon-512.png         200

# SEO crawler files.
/converter/robots.txt           /robots.txt           200
/converter/sitemap.xml          /sitemap.xml          200

# SPA fallback — everything else under /converter/ serves the shell.
/converter/*                    /index.html           200
